<?xml version="1.0" encoding="utf-8"?>
<!-- The TV launcher (TV Clean 0.2): our own leanback home screen, package
     ai.promptstudio.tvclean.launcher. The HOME activity is the TV's home screen; the ThemeProvider
     is how the phone writes the look (config.json + wallpaper.jpg) into this app's own files, so the
     look is never blocked by the shell's write lock (RFC-THEME-1, ThemeProviderLines). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_launcher"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Launcher">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The ThemeProvider (RFC-THEME-1): exported, guarded by WRITE_SECURE_SETTINGS, which only
             the shell and the system hold. Ordinary apps on the TV cannot write the look; the phone's
             adb shell can. It opens config.json, wallpaper.jpg and theme_revision under this app's
             external files folder (/sdcard/Android/data/ai.promptstudio.tvclean.launcher/files). -->
        <provider
            android:name=".ThemeProvider"
            android:authorities="ai.promptstudio.tvclean.launcher.theme"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:grantUriPermissions="false" />
    </application>
</manifest>
